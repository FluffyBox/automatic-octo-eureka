# Optional analytics / SEO env vars. The site builds and runs without them.
# Copy to .env.local and fill in to enable.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# When set, GA4 loads ONLY after the visitor accepts cookies. Contact-link
# clicks (WhatsApp / phone / email) are tracked as `generate_lead` events.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value of the
# `google-site-verification` meta tag). Rendered site-wide in <head>.
NEXT_PUBLIC_GSC_VERIFICATION=
